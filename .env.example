# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local

# Data services
DATABASE_URL=postgres://localhost:5432/processtwin
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# LLM provider
LLM_PROVIDER=gemini
LLM_MODEL=<gemini-model-name>
LLM_PROVIDER_TIMEOUT_SECONDS=30
LLM_PROVIDER_MAX_RETRIES=2
GEMINI_API_KEY=

# RAG embedding provider (independent from LLM_PROVIDER)
RAG_EMBEDDING_PROVIDER=gemini
RAG_GEMINI_TIMEOUT_MS=10000
RAG_OLLAMA_TIMEOUT_SECONDS=30
RAG_OLLAMA_BULK_TIMEOUT_SECONDS=300

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Provider profiles:
# Online: LLM_PROVIDER=gemini, RAG_EMBEDDING_PROVIDER=gemini
# Local: LLM_PROVIDER=ollama, LLM_MODEL=gemma4:12b-it-qat,
#        RAG_EMBEDDING_PROVIDER=ollama (validated local descriptor)
# Mixed profiles may select gemini/ollama independently for these two settings.

# Internal service auth
INTERNAL_API_SERVICE_TOKEN=
MCP_BACKEND_BASE_URL=http://127.0.0.1:8000
MCP_BACKEND_SERVICE_TOKEN=
MCP_BACKEND_TIMEOUT_SECONDS=5

# INTERNAL_API_SERVICE_TOKEN and MCP_BACKEND_SERVICE_TOKEN must contain the same secret value.
# Do not commit a real token.

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000
NETWORK_MCP_PORT=8101
CUSTOMER_MCP_PORT=8102
RULE_MCP_PORT=8103
COMPENSATION_MCP_PORT=8104
ANALYTICS_MCP_PORT=8105
SIMULATION_MCP_PORT=8106

# MCP base URLs
NETWORK_MCP_BASE_URL=http://localhost:8101
CUSTOMER_MCP_BASE_URL=http://localhost:8102
RULE_MCP_BASE_URL=http://localhost:8103
COMPENSATION_MCP_BASE_URL=http://localhost:8104
ANALYTICS_MCP_BASE_URL=http://localhost:8105
SIMULATION_MCP_BASE_URL=http://localhost:8106
